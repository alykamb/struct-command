{
    "name": "@collidor/struct-command",
    "version": "0.1.0",
    "description": "Unifies @collidor/struct schemas for input and output definition, validation, and type inference on Collidor commands.",
    "repository": {
        "type": "git",
        "url": "https://github.com/collidor/struct-command.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/main.cjs",
    "module": "dist/main.js",
    "types": "dist/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "import": "./dist/main.js",
            "require": "./dist/main.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "deno test",
        "lint": "oxlint",
        "test:coverage": "deno test --coverage && deno coverage --lcov --output=./coverage/lcov.info && deno coverage --html",
        "publish:jsr": "deno run --allow-all ./publishJsr.ts",
        "sync:jsr": "deno run --allow-read --allow-write ./sync.ts",
        "release": "semantic-release"
    },
    "keywords": [
        "command",
        "command bus",
        "command handler",
        "struct",
        "schema",
        "validation"
    ],
    "author": "Alykam Burdzaki <alykam@gmail.com> (https://alykam.com)",
    "license": "MIT",
    "devDependencies": {
        "@collidor/command": "^7.3.4",
        "@collidor/struct": "^0.2.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/exec": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@swc/core": "^1.13.5",
        "oxlint": "^1.78.0",
        "semantic-release": "^24.2.3",
        "tsup": "8.5.0",
        "typescript": "5.9.2"
    },
    "dependencies": {
        "@collidor/command": "^7.3.4"
    },
    "peerDependencies": {
        "@collidor/struct": ">=0.2.0"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
